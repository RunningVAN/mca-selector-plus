#!/bin/bash
# a script to update all files containing the version.

gradlePropertiesFile='gradle.properties'

ReadGradleProperty() {
  # anchored match, and only the first hit: the plus layer adds keys such as plus.version and
  # plus.application.name, a loose grep collected several lines and glued their values together
  local value=`grep -m 1 "^$1=" $gradlePropertiesFile | cut -d'=' -f2-`
  echo "$value"
}

applicationVersion=$(ReadGradleProperty 'version')
plusVersion=$(ReadGradleProperty 'plus.version')

# update README.md
# the core version lives in the vs/ve markers, the plus version in the pv/pe markers
sed -i -E "s/<!--vs-->[0-9]+\.[0-9]+(\.[0-9]+)?<!--ve-->/<!--vs-->$applicationVersion<!--ve-->/g" 'README.md'
sed -i -E "s/<!--pv-->[0-9]+\.[0-9]+(\.[0-9]+)?<!--pe-->/<!--pv-->$plusVersion<!--pe-->/g" 'README.md'
# release tag plus-<core>-<plus>
sed -i -E "s/releases\/download\/plus-[0-9]+\.[0-9]+(\.[0-9]+)?-[0-9]+\.[0-9]+(\.[0-9]+)?/releases\/download\/plus-$applicationVersion-$plusVersion/g" 'README.md'
# asset names mcaselector-plus-<core>-plus-<plus>-<platform> and mcaselector-plus-<core>-plus-<plus>.jar
sed -i -E "s/mcaselector-plus-[0-9]+\.[0-9]+(\.[0-9]+)?-plus-[0-9]+\.[0-9]+(\.[0-9]+)?-/mcaselector-plus-$applicationVersion-plus-$plusVersion-/g" 'README.md'
sed -i -E "s/mcaselector-plus-[0-9]+\.[0-9]+(\.[0-9]+)?-plus-[0-9]+\.[0-9]+(\.[0-9]+)?\.jar/mcaselector-plus-$applicationVersion-plus-$plusVersion.jar/g" 'README.md'

# the workflows derive every asset name from gradle.properties at build time, so there is nothing to
# patch in .github/workflows/release-plus.yml - the readme was the only hard coded copy

# update issue template
sed -i -E "s/Version of MCA Selector Plus \[e\.g\. [0-9]+\.[0-9]+(\.[0-9]+)? - Plus [0-9]+\.[0-9]+(\.[0-9]+)?/Version of MCA Selector Plus [e.g. $applicationVersion - Plus $plusVersion/g" '.github/ISSUE_TEMPLATE/bug_report.md'

Len() {
  local res=${1//[^.]}
  echo "${#res}"
}

# update the linux desktop entry
sed -i -E "s/Version=[0-9]+\.[0-9]+(\.[0-9]+)?/Version=$applicationVersion/g" 'installer/linux/mcaselector-plus.desktop'

# update copyright year (keep whatever sign the file uses, upstream writes a half width one)
sed -i -E "s/(copyright=.*2018 *- *)[0-9]{4}/\1$(date +%Y)/g" 'gradle.properties'
sed -i -E "s/(Copyright *\(c\) *2018 *- *)[0-9]{4}/\1$(date +%Y)/g" 'LICENSE'
